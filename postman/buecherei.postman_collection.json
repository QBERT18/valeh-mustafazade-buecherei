        {
          "name": "List books – sort by year, newest first",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sorted by Jahr descending', () => {",
                  "  const years = pm.response.json().map(b => new Date(b.Jahr).getUTCFullYear());",
                  "  pm.expect(years).to.eql([...years].sort((a, b) => b - a));",
                  "});"
                ]
              }
