    {
      "name": "3 Book files",
      "description": "Datei hochladen, herunterladen, löschen. Der Upload braucht `tests/testdata/test.pdf` (Working Directory = Projektordner).",
      "item": [
        {
          "name": "Upload book file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('file stored', () => pm.expect(pm.response.json().FileName).to.eql('test.pdf'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}/file",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "tests/testdata/test.pdf"
                }
              ]
            }
          }
        },
        {
          "name": "Download book file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is a PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}/file"
          }
        },
        {
          "name": "Delete book file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}/file"
          }
        },
        {
          "name": "Download book file – gone (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('book has no file'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}/file"
          }
        }
      ]
    },
