{
  "info": {
    "name": "Bewerbertag",
    "description": "Bücherei-API. Läuft als Ganzes von oben nach unten (Collection Runner oder Newman): legt eigene Testdaten an, prüft jeden Statuscode und räumt am Ende auf.\n\n`baseUrl` = http://localhost:8080. Für die Upload-Requests muss das Working Directory der Projektordner sein.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "shelfId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "praesenzBookId",
      "value": ""
    },
    {
      "key": "personId",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "smallShelfId",
      "value": ""
    },
    {
      "key": "bookAId",
      "value": ""
    },
    {
      "key": "bookBId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Shelves",
      "description": "Regal anlegen, lesen, suchen, ändern.",
      "item": [
        {
          "name": "Create shelf",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('shelfId', pm.response.json().ID);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/shelves",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ShelfName\": \"Postman Regal\",\n  \"Limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List shelves",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('contains the created entry', () => pm.expect(pm.response.json().map(x => x.ID)).to.include(Number(pm.collectionVariables.get('shelfId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shelves"
          }
        },
        {
          "name": "List shelves – search + sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('contains the created entry', () => pm.expect(pm.response.json().map(x => x.ID)).to.include(Number(pm.collectionVariables.get('shelfId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shelves?q=postman&sort=-name"
          },
          "description": "`q` sucht im Namen, `sort` = name | limit, `-` davor = absteigend."
        },
        {
          "name": "Get shelf",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shelves/{{shelfId}}"
          }
        },
        {
          "name": "Update shelf",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('updated', () => pm.expect(pm.response.json().Limit).to.eql(20));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/shelves/{{shelfId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ShelfName\": \"Postman Regal (neu)\",\n  \"Limit\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
